{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/submit-rsvp.php",
      "dest": "/submit-rsvp.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
